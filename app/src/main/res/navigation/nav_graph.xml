<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.studentapp77803.ui.HomeFragment"
        android:label="Home">

        <action
            android:id="@+id/action_home_to_register"
            app:destination="@id/registerFragment" />

        <action
            android:id="@+id/action_home_to_search"
            app:destination="@id/searchFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.studentapp77803.ui.RegisterFragment"
        android:label="Register Student" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.studentapp77803.ui.SearchFragment"
        android:label="Search Student" />
</navigation>